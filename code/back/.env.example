# Modelo do arquivo .env (este pode ser commitado; o .env com as chaves NÃO).
# Copie para ".env" e preencha. Rode o backend a partir da pasta code/back.
# Chave vazia = aquele provedor fica desativado e o backend avisa na resposta.

# ---------------------------------------------------------------------------
# 1) Travelpayouts / Aviasales  ->  VOOS (preços de passagens, em BRL)
#    Cadastro grátis: https://www.travelpayouts.com  (crie a conta e adicione um "projeto/site")
#    O token fica em: Perfil > "API token" (ou https://www.travelpayouts.com/developers/api)
#    O marker é o seu ID de parceiro (Partner ID), que aparece no painel; é ele que gera
#    comissão nos links de compra. Sem marker tudo funciona, só não há comissão.
# ---------------------------------------------------------------------------
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Mercado dos dados de preço. "br" = buscas de usuários brasileiros.
# Se as buscas voltarem sempre vazias, teste com "ru" (padrão do Travelpayouts).
TRAVELPAYOUTS_MARKET=br

# ---------------------------------------------------------------------------
# 2) LiteAPI (Nuitée)  ->  HOTÉIS
#    Cadastro grátis: https://dashboard.liteapi.travel/register
#    Em Perfil/Profile copie a "Sandbox API key" (começa com sand_ ; dados de TESTE).
#    Quando quiser dados reais, troque pela chave de produção (prod_) no mesmo lugar.
# ---------------------------------------------------------------------------
LITEAPI_KEY=

# ---------------------------------------------------------------------------
# 3) Pexels  ->  FOTOS dos destinos (opcional; sem a chave os resultados saem sem foto)
#    Cadastro grátis: https://www.pexels.com/api/  (botão "Get Started")
# ---------------------------------------------------------------------------
PEXELS_API_KEY=

# ---------------------------------------------------------------------------
# Sem chave (nada a preencher):
#  - Travelpayouts Places/Airports  -> autocomplete de cidades e aeroportos
#  - Open-Meteo Geocoding           -> coordenadas dos municípios (grátis só p/ uso NÃO comercial)
# ---------------------------------------------------------------------------

# Configurações opcionais
# Porta do backend
PORT=8080

# Banco de dados da autenticação
DB_URL=jdbc:postgresql://localhost:5432/limity
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DDL_AUTO=update

# Deve ter pelo menos 32 caracteres em ambientes reais
JWT_SECRET=troque-esta-chave-por-uma-chave-segura-com-32-caracteres
JWT_EXPIRATION=PT2H
# Origens do front liberadas no CORS, separadas por vírgula (aceita curinga na porta)
CORS_ALLOWED_ORIGINS=http://localhost:*
